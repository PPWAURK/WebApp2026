// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                         @id @default(autoincrement())
  email               String                      @unique
  passwordHash        String
  name                String?
  profilePhoto        String?                     @map("profile_photo") @db.Text
  restaurantId        Int?
  restaurant          Restaurant?                 @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  role                Role                        @default(EMPLOYEE)
  employeeLevel       EmployeeLevel               @default(L0_PROBATION)
  isApproved          Boolean                     @default(true)
  emailVerifiedAt     DateTime?                   @map("email_verified_at")
  isOnProbation       Boolean                     @default(false)
  preferredLanguage   String                      @default("fr") @map("preferred_language") @db.VarChar(5)
  workplaceRole       WorkplaceRole               @default(BOTH)
  trainingAccess      Json?
  levelAccessProfile  EmployeeLevelAccessProfile? @relation(fields: [employeeLevel], references: [employeeLevel], onDelete: Restrict, onUpdate: Cascade)
  documents           Document[]
  newsPostsCreated    NewsPost[]                  @relation("NewsPostCreator")
  newsPostReads       NewsPostRead[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  purchaseOrders      PurchaseOrder[]             @relation("CreatedByUser")
  purchaseReturns     PurchaseReturn[]            @relation("CreatedByUserReturns")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
}

model EmployeeLevelAccessProfile {
  id            Int           @id @default(autoincrement())
  employeeLevel EmployeeLevel @unique @map("employee_level")
  sections      Json?
  users         User[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("employee_level_access_profiles")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Restaurant {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  address         String
  users           User[]
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Produit {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  supplierId          Int                  @map("supplier_id")
  reference           String?              @db.VarChar(100)
  categorie           String               @db.VarChar(20)
  nomCn               String               @map("nom_cn") @db.VarChar(255)
  designationFr       String?              @map("designation_fr") @db.VarChar(255)
  specification       String?              @db.VarChar(100)
  unite               String?              @db.VarChar(100)
  prixUHt             Decimal?             @map("prix_u_ht") @db.Decimal(10, 2)
  image               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@map("produits")
}

model Fournisseur {
  id              Int              @id @default(autoincrement())
  nom             String           @db.VarChar(255)
  sortOrder       Int              @map("sort_order")
  purchaseOrders  PurchaseOrder[]
  purchaseReturns PurchaseReturn[]

  @@index([sortOrder])
  @@map("fournisseurs")
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  number          String              @unique @db.VarChar(50)
  supplierId      Int                 @map("supplier_id")
  supplier        Fournisseur         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  restaurantId    Int                 @map("restaurant_id")
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdByUserId Int                 @map("created_by_user_id")
  createdByUser   User                @relation("CreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveryDate    DateTime            @map("delivery_date") @db.Date
  deliveryAddress String              @map("delivery_address") @db.VarChar(255)
  totalItems      Int                 @map("total_items")
  totalAmount     Decimal             @map("total_amount") @db.Decimal(10, 2)
  bonFileName     String              @map("bon_file_name") @db.VarChar(191)
  items           PurchaseOrderItem[]
  returns         PurchaseReturn[]
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([restaurantId, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int                  @id @default(autoincrement())
  purchaseOrderId Int                  @map("purchase_order_id")
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       BigInt               @map("product_id") @db.UnsignedBigInt
  product         Produit              @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierId      Int                  @map("supplier_id")
  quantity        Int
  unitPriceHt     Decimal              @map("unit_price_ht") @db.Decimal(10, 2)
  lineTotal       Decimal              @map("line_total") @db.Decimal(10, 2)
  nameZh          String               @map("name_zh") @db.VarChar(255)
  nameFr          String?              @map("name_fr") @db.VarChar(255)
  unit            String?              @db.VarChar(100)
  category        String               @db.VarChar(20)
  returnItems     PurchaseReturnItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model PurchaseReturn {
  id              Int                  @id @default(autoincrement())
  purchaseOrderId Int                  @map("purchase_order_id")
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierId      Int                  @map("supplier_id")
  supplier        Fournisseur          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  restaurantId    Int                  @map("restaurant_id")
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdByUserId Int                  @map("created_by_user_id")
  createdByUser   User                 @relation("CreatedByUserReturns", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reason          String               @db.VarChar(255)
  notes           String?              @db.Text
  totalItems      Int                  @map("total_items")
  items           PurchaseReturnItem[]
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([purchaseOrderId])
  @@index([restaurantId, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                  Int                       @id @default(autoincrement())
  purchaseReturnId    Int                       @map("purchase_return_id")
  purchaseReturn      PurchaseReturn            @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId Int                       @map("purchase_order_item_id")
  purchaseOrderItem   PurchaseOrderItem         @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  productId           BigInt                    @map("product_id") @db.UnsignedBigInt
  product             Produit                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity            Int
  nameZh              String                    @map("name_zh") @db.VarChar(255)
  nameFr              String?                   @map("name_fr") @db.VarChar(255)
  unit                String?                   @db.VarChar(100)
  category            String                    @db.VarChar(20)
  photos              PurchaseReturnItemPhoto[]

  @@index([purchaseReturnId])
  @@index([purchaseOrderItemId])
  @@index([productId])
  @@map("purchase_return_items")
}

model PurchaseReturnItemPhoto {
  id                   Int                @id @default(autoincrement())
  purchaseReturnItemId Int                @map("purchase_return_item_id")
  purchaseReturnItem   PurchaseReturnItem @relation(fields: [purchaseReturnItemId], references: [id], onDelete: Cascade)
  documentId           Int                @map("document_id")
  document             Document           @relation("PurchaseReturnItemPhotoDocument", fields: [documentId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamp(0)

  @@unique([purchaseReturnItemId, documentId], map: "purchase_return_item_photos_item_doc_key")
  @@index([documentId])
  @@map("purchase_return_item_photos")
}

model Document {
  id                       Int                       @id @default(autoincrement())
  fileName                 String                    @unique
  category                 UploadCategory
  originalName             String
  customCategory           String?                   @map("custom_category") @db.VarChar(80)
  mimeType                 String
  size                     Int
  mediaType                UploadMediaType
  module                   UploadModule
  section                  UploadSection
  uploadedAt               DateTime                  @default(now())
  uploadedByUserId         Int?
  uploadedBy               User?                     @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  attachedToNewsPosts      NewsPost[]                @relation("NewsPostAttachment")
  purchaseReturnItemPhotos PurchaseReturnItemPhoto[] @relation("PurchaseReturnItemPhotoDocument")

  @@index([module, section, mediaType, uploadedAt])
  @@index([module, section, customCategory, uploadedAt])
}

model ModuleCategory {
  id        Int           @id @default(autoincrement())
  module    UploadModule
  name      String        @db.VarChar(80)
  section   UploadSection
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@unique([module, name])
  @@index([module, section])
  @@map("module_categories")
}

model NewsPost {
  id                    Int            @id @default(autoincrement())
  title                 String         @db.VarChar(191)
  message               String         @db.Text
  audience              NewsAudience   @default(ALL)
  tags                  Json?
  visibleEmployeeLevels Json?          @map("visible_employee_levels")
  module                UploadModule?
  section               UploadSection?
  attachmentDocumentId  Int?           @map("attachment_document_id")
  attachmentDocument    Document?      @relation("NewsPostAttachment", fields: [attachmentDocumentId], references: [id], onDelete: SetNull)
  createdByUserId       Int            @map("created_by_user_id")
  createdByUser         User           @relation("NewsPostCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  reads                 NewsPostRead[]
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([createdAt])
  @@index([audience, createdAt])
  @@index([module, section, createdAt])
  @@index([attachmentDocumentId])
  @@index([createdByUserId])
  @@map("news_posts")
}

model NewsPostRead {
  id         Int      @id @default(autoincrement())
  newsPostId Int      @map("news_post_id")
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now()) @map("read_at") @db.Timestamp(0)

  @@unique([newsPostId, userId])
  @@index([userId, readAt])
  @@map("news_post_reads")
}

model TrainingQuizLink {
  id        Int           @id @default(autoincrement())
  section   UploadSection
  language  String        @db.VarChar(5)
  quizUrl   String        @map("quiz_url") @db.VarChar(2048)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([section, language])
  @@map("training_quiz_links")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum WorkplaceRole {
  SALLE
  CUISINE
  BOTH
}

enum EmployeeLevel {
  L0_PROBATION
  L1_PARTNER
  L2_PARTNER
  L3_PARTNER
  L4_EXCELLENT
  L5_PAM
  L5_AM
  L6_PM
  L6_MA
  L7_PDI
  L7_D
}

enum UploadCategory {
  images
  videos
  documents
}

enum UploadMediaType {
  image
  video
  document
}

enum UploadModule {
  TRAINING
  POLICY
  MANAGEMENT
  FORMS
}

enum UploadSection {
  RECIPE_TRAINING
  RECIPE
  MISE_EN_PLACE_SOP
  RED_RULES
  BLACK_RULES
  SALLE_TOOLS
  CUISINE_TOOLS
  ORDER_RETURNS
  MEAT_DATE_FORM
  CLEANING_FORM
}

enum NewsAudience {
  ALL
  MANAGERS
  EMPLOYEES
}
